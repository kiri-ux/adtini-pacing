# --- S3 delivery feed -----------------------------------------------------
# The bucket the daily client-serve drops land in.
S3_BUCKET=adtini-orders
S3_PREFIX=orders/
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# --- Database -------------------------------------------------------------
# Render sets this automatically when a Postgres instance is attached.
# Without it the tool runs on a local SQLite file.
DATABASE_URL=

# --- App ------------------------------------------------------------------
# Shared password for the buying team. Blank disables the login gate.
APP_PASSWORD=
SESSION_SECRET=change-me
